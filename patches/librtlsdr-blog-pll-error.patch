+/* Actual tuned centre minus requested centre (Hz), for tuners with coarse PLL steps */
+int rtlsdr_get_tuner_freq_error(rtlsdr_dev_t *dev)
+{
+	if (!dev || dev->direct_sampling)
+		return 0;
+	if (dev->tuner_type == RTLSDR_TUNER_R820T || dev->tuner_type == RTLSDR_TUNER_R828D)
+		return dev->r82xx_p.pll_err;
+	return 0;
+}
