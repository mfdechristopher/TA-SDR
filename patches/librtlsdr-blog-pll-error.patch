@@ -534,6 +534,12 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 		n_sdm <<= 1;
 	}
 
+	/* record the LO frequency error caused by integer-kHz truncation and SDM resolution */
+	{
+		double vco_act = 2.0 * (double)pll_ref * ((double)nint + (double)sdm / 65536.0);
+		priv->pll_err = (int32_t)(vco_act / (double)mix_div - (double)freq + ((vco_act / (double)mix_div - (double)freq) < 0 ? -0.5 : 0.5));
+	}
+
 	rc = r82xx_write_reg(priv, 0x16, sdm >> 8);
 	if (rc < 0)
 		return rc;
